NODE_ENV=production
DRY_RUN=true
RECLOUD_WRITE_ENABLED=false
RECLOUD_REVEAL_PHONE_ENABLED=false
FIELDDESK_AUTH_MODE=accounts
FIELDDESK_STORAGE_DRIVER=sqlite
FIELDDESK_SQLITE_FILE=/var/lib/fielddesk/fielddesk.sqlite
FIELDDESK_DATA_DIRECTORY=/var/lib/fielddesk
FIELDDESK_BACKUP_DIRECTORY=/var/backups/fielddesk
FIELDDESK_BOOTSTRAP_ADMIN_TOKEN=REPLACE_WITH_SECRET_MANAGER_VALUE_AT_LEAST_32_CHARS
FIELDDESK_SESSION_HOURS=12
FRONTEND_ORIGIN=https://fielddesk.example.com
TRUST_PROXY=loopback
TLS_ENABLED=false
PORT=3000
REQUEST_BODY_LIMIT=140mb
UPLOAD_MAX_FILE_BYTES=100000000
UPLOAD_MAX_STORAGE_BYTES=5368709120
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_15_MINUTES=10
LOG_DIRECTORY=/var/log/fielddesk
LOG_MAX_BYTES=10485760
LOG_RETENTION_FILES=14
AUDIT_RETENTION_DAYS=365
AUDIT_MAX_ENTRIES=100000
BACKUP_RETENTION_DAYS=30
