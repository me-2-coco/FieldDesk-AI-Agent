<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>cn.fielddesk.guardian</string>
  <key>ProgramArguments</key><array><string>__NODE__</string><string>__PROJECT__/scripts/start-service-guardian.js</string></array>
  <key>WorkingDirectory</key><string>__PROJECT__</string>
  <key>EnvironmentVariables</key><dict>
    <key>FIELDDESK_GUARDIAN_ENABLED</key><string>true</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>60</integer>
  <key>AbandonProcessGroup</key><false/>
  <key>StandardOutPath</key><string>__PROJECT__/runtime/guardian.log</string>
  <key>StandardErrorPath</key><string>__PROJECT__/runtime/guardian.log</string>
</dict></plist>
