[Unit]
Description=FieldDesk API
After=network.target

[Service]
Type=simple
User=fielddesk
Group=fielddesk
WorkingDirectory=/opt/fielddesk
EnvironmentFile=/etc/fielddesk/fielddesk.env
ExecStartPre=/usr/bin/npm run db:migrate
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fielddesk /var/log/fielddesk /var/backups/fielddesk

[Install]
WantedBy=multi-user.target
